# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase project dashboard: Settings -> API Keys.
# (Supabase renamed the old "anon key" to "publishable key" — use that one.)
# Never commit the real .env file — it's already in .gitignore.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
